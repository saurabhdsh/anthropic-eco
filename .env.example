# Same values SEAL uses on this EC2. ANTHROPIC_API_KEY stays empty.
# The instance role WeaveEC2BedrockRole is the credential.
AWS_REGION=us-east-1
BEDROCK_ENABLED=true
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Optional. Set this only if you want the last beat to call a second model.
# CLAUDE_FAST_MODEL=us.anthropic.claude-haiku-4-5
